{
	"name": "fgtclb/page-backend-layout",
	"type": "typo3-cms-extension",
	"description": "FGTCLB: Page Backend Layout - Helper for Backend layout overrides based on page doktype",
	"minimum-stability": "stable",
	"license": "GPL-2.0-or-later",
	"config": {
		"vendor-dir": ".Build/vendor",
		"bin-dir": ".Build/bin",
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true,
			"sbuerk/fixture-packages": true
		}
	},
	"extra": {
		"branch-alias": {
			"dev-main": "3.x.x-dev"
		},
		"typo3/cms": {
			"cms-package-dir": "{$vendor-dir}/typo3/cms",
			"extension-key": "page_backend_layout",
			"ignore-as-root": false,
			"web-dir": ".Build/public",
			"app-dir": ".Build",
			"version": "3.0.0",
			"Package": {
				"providesPackages": []
			}
		},
		"sbuerk/fixture-packages": {
			"paths": ["Tests/Fixtures/Extensions/*"]
		}
	},
	"require": {
		"php": "^8.2 || ^8.3 || ^8.4 || ^8.5",
		"typo3/cms-backend": "^13.4 || ^14.3",
		"typo3/cms-core": "^13.4 || ^14.3",
		"typo3/cms-fluid": "^13.4 || ^14.3"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.14",
		"nikic/php-parser": "^5.4",
		"phpstan/phpstan": "^2.1.33",
		"phpunit/phpunit": "^11.5.55",
		"saschaegerer/phpstan-typo3": "^2.2 || ^3.1",
		"sbuerk/fixture-packages": "^1.1.4",
		"typo3/cms-info": "^13.4 || ^14.3",
		"typo3/cms-lowlevel": "^13.4 || ^14.3",
		"typo3/cms-tstemplate": "^13.4 || ^14.3",
		"typo3/testing-framework": "^9.7.0"
	},
	"autoload": {
		"psr-4": {
			"FGTCLB\\PageBackendLayout\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"FGTCLB\\PageBackendLayout\\Tests\\": "Tests/"
		}
	}
}
